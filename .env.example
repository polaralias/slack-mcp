SLACK_MCP_XOXC_TOKEN=<paste-slack-browser-token>
SLACK_MCP_XOXD_TOKEN=<paste-slack-cookie-d-value>
SLACK_MCP_API_KEY=change-me

# Optional MCP exposure controls
# Leave unset or set to all for the full validated 22-tool surface.
# SLACK_MCP_ENABLED_TOOLS=all

# Optional network/runtime settings
# SLACK_MCP_HOST=127.0.0.1
# SLACK_MCP_PORT=3005
# SLACK_MCP_PATH=/mcp
# MCP_HEALTH_PATH=/health
# SLACK_MCP_USER_AGENT=slack-mcp-native/1.0
# SLACK_MCP_WORKSPACE=workspace

# Optional API-key auth alternatives
# MCP_API_KEY=change-me
# MCP_API_KEYS=key-one,key-two
# API_KEY_MODE=disabled
# Only set this for intentional no-auth deployments.

# Optional Slack behavior controls
# SLACK_MCP_GOVSLACK=false
